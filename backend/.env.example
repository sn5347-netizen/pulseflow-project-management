# PulseFlow Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database options:
# 1. Local SQLite (Default, Zero-configuration):
DATABASE_URL="file:./dev.db"

# 2. Local/Docker PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseflow?schema=public"

# 3. Hosted Neon / Supabase PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/pulseflow?sslmode=require"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_EXPIRES_IN="7d"

# CORS configuration (web frontend URL)
CORS_ORIGIN="http://localhost:3000"

